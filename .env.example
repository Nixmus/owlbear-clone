# Copy to `.env` and adjust for your deployment.

# HTTP + WebSocket port
PORT=4000

# Secret used to sign auth tokens. CHANGE THIS in production.
JWT_SECRET=change-me-in-production

# Only needed if the frontend is hosted on a different origin than the API
# (e.g. GitHub Pages frontend + external backend). Comma-separated list.
# CORS_ORIGIN=https://tu-usuario.github.io

# Path to the SQLite database file (inside the container: /app/data/owlbear.db)
# DATABASE_FILE=./data/owlbear.db

# Directory for uploaded assets (defaults to <data>/uploads)
# UPLOAD_DIR=./data/uploads

# SQLite journal mode. Use "delete" on network filesystems (e.g. Azure Files).
# SQLITE_JOURNAL=WAL

# Optional: use PostgreSQL instead of SQLite (requires code changes / adapter)
# DATABASE_URL=postgres://owlbear:owlbear@db:5432/owlbear
